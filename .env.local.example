# Example environment variables for local development / docs
# Copy this to .env.local and fill in real values. DO NOT commit .env.local.

# Public (client-side) Supabase keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Server (secret) Supabase credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-secret

# Discord bot (server-only) — SECRET
DISCORD_BOT_TOKEN=your-discord-bot-token

# IDs and optional overrides
DISCORD_GUILD_ID=1465698764453838882
DEVELOPER_GUILD_ID=1465698764453838882
DEVELOPER_ROLE_ID=1467580199481639013

# API endpoints
BOT_API_URL=http://localhost:3000

# Optional public links
NEXT_PUBLIC_DISCORD_BOT_INVITE=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local auth bypass is automatic on next dev + localhost.
# Set to false/0 to force Discord login even on localhost.
# ALLOW_LOCAL_DEV_BYPASS=true

# Timeouts (ms)
DISCORD_API_TIMEOUT_MS=10000

# Quiz Event sistemi — bot veya harici cron (cron-job.org) için ortak secret.
# Production'da ZORUNLU. cron-job.org veya benzeri ile /api/cron/quiz-* endpoint'lerini tetikleyin.
# Auth: ?secret=... veya Authorization: Bearer ...
# Detaylı kurulum: README.md → "Quiz Etkinlikleri — Cron, Zamanlayıcı ve Kotalar"
QUIZ_CRON_SECRET=
